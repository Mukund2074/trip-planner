# Server
PORT=5173

# MongoDB Atlas (required on Netlify; optional locally — falls back to in-memory DB)
MONGODB_URI=

# JWT Secret (required — use: openssl rand -base64 32)
JWT_SECRET=

# Default password for new members (required — server-side only)
DEFAULT_MEMBER_PASSWORD=

# Site URL for CORS (Netlify sets URL automatically; use http://localhost:5173 locally)
CLIENT_URL=http://localhost:5173

# Google Drive folder link (shown to logged-in members)
VITE_GOOGLE_DRIVE_URL=https://drive.google.com
